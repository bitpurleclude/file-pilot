{
  "name": "file-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/bitpurleclude/file-pilot.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "native:rebuild:node": "npm rebuild better-sqlite3",
    "native:rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "test": "npm run native:rebuild:node && vitest run --root . apps/desktop/tests/unit apps/desktop/tests/integration",
    "test:e2e": "npm run native:rebuild:electron && playwright test",
    "test:e2e:core": "npm run native:rebuild:electron && playwright test apps/desktop/tests/e2e/startup.spec.ts apps/desktop/tests/e2e/workflow.spec.ts apps/desktop/tests/e2e/rollback.spec.ts",
    "test:e2e:list": "playwright test --list",
    "test:qa": "npm run native:rebuild:node && vitest run --root . apps/desktop/tests/qa",
    "test:qa:perf": "npm run native:rebuild:node && vitest run --root . apps/desktop/tests/qa/performance-100-files.test.ts",
    "test:qa:reliability": "npm run native:rebuild:node && vitest run --root . apps/desktop/tests/qa/rollback-reliability.test.ts",
    "build:renderer": "vite build",
    "build:electron": "esbuild apps/desktop/electron/main/index.ts --bundle --platform=node --format=cjs --external:electron --external:better-sqlite3 --outfile=dist/electron/main.cjs && esbuild apps/desktop/electron/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/electron/preload.cjs && node scripts/copy-sqlite-migrations.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "dev": "vite",
    "pack": "npm pack",
    "dist:win": "npm run build && npm run native:rebuild:electron && electron-builder --win --publish never",
    "dist:win:portable": "npm run build && npm run native:rebuild:electron && electron-builder --win portable --publish never"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/vite": "^4.2.1",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^25.8.13",
    "lucide-react": "^0.575.0",
    "nunjucks": "^3.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.55.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/nunjucks": "^3.2.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.10",
    "eslint": "^9.34.0",
    "rcedit": "^5.0.1",
    "typescript": "^5.9.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.bitpurleclude.filepilot",
    "productName": "File Pilot",
    "forceCodeSigning": false,
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "bitpurleclude",
      "repo": "file-pilot"
    },
    "win": {
      "icon": "resources/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico"
    },
    "portable": {
      "artifactName": "File-Pilot-${version}-Portable.exe"
    }
  }
}
